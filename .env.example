# Copy to .env.local and fill in. `.env` is never committed (see .gitignore).
# Non-functional requirement from the brief: secrets stay out of the repository.

# --- Database ---
# Required: the app and the db scripts fail at start without it.
DATABASE_URL="postgresql://moonlight:moonlight@localhost:5433/moonlight"
# Only for a hosted database whose certificate comes from its own root CA (Supabase):
# the PEM text of that root. Leave sslmode out of DATABASE_URL when it is set.
DATABASE_CA_CERT=


# --- Imports and tailoring ---
# LinkedIn profiles are read with the Apify actor atomus/linkedin-profile-scraper.
APIFY_TOKEN=
# Résumé PDFs and tailored profiles use Claude. The workspace id is needed only
# when the key is not scoped to a workspace.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
