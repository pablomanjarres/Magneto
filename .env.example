# Copy to .env.local and fill in. `.env` is never committed (see .gitignore).
# Non-functional requirement from the brief: secrets stay out of the repository.

# --- Database ---
# Required: the app and the db scripts fail at start without it.
DATABASE_URL="postgresql://moonlight:moonlight@localhost:5433/moonlight"

# --- API ---
# API_PORT is read by the Express branch of the comparison PoC (apps/api).
API_PORT=4000
