# Copy to .env.local and fill in. `.env` is never committed (see .gitignore).
# Non-functional requirement from the brief: secrets stay out of the repository.

# --- Database ---
DATABASE_URL="postgresql://moonlight:moonlight@localhost:5433/moonlight"

# --- Auth ---
# Nothing reads these yet: sign-in is HU_NF #32 and lands in a later sprint.
# openssl rand -base64 32
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# --- API ---
# API_PORT is read by the Express branch of the comparison PoC (apps/api).
API_PORT=4000
# Not read yet: the web app talks to its own route handlers, per ADR 0001.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Rate limiting (critical endpoints) ---
# Not read yet: HU_NF #34.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Logging ---
# Not read yet: HU_NF #36.
LOG_LEVEL="info"
